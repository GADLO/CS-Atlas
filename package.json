{
  "name": "cs-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CS Atlas · 计算机系统图谱：以《计算机组成与设计（RISC-V版）》为依据的全栈计算机系统抽象应用",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch server/src/index.js\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/src/index.js",
    "seed": "node server/src/seed.js",
    "test": "node --test server/test/*.test.js",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "check:data": "node scripts/check-data.js",
    "check:questions": "node scripts/check-questions.js",
    "db:reset": "node scripts/reset-db.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "lucide-react": "1.71.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "10.0.7",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "engines": {
    "node": ">=22.12"
  }
}
