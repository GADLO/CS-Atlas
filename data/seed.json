    {
      "slug": "cpu-performance",
      "type": "model",
      "name": "CPU 性能公式",
      "name_en": "CPU Performance Equation",
      "category": "性能模型",
      "layer": "微架构层",
      "summary": "用指令数、CPI 与时钟周期解释程序执行时间。",
      "description": [
        "CPU 时间可以写成指令数乘以 CPI 再乘以时钟周期。",
        "三个因子相互牵制，优化其中一个往往会改变另外两个。"
      ],
      "specs": [
        {
          "label": "公式",
          "value": "CPU 时间 = IC × CPI × 时钟周期"
        },
        {
          "label": "等价形式",
          "value": "CPU 时间 = IC × CPI / 频率"
        },
        {
          "label": "适用",
          "value": "单核程序级性能估算"
        }
      ],
      "highlights": [
        "性能三因子",
        "优化需要看整体取舍"
      ],
      "tags": [
        "性能",
        "CPI"
      ],
      "book": {
